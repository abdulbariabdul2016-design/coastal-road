# للتشغيل المحلي فقط (لا ترفع ملف .env الحقيقي إلى GitHub)
SECRET_KEY=ضع-قيمة-عشوائية-طويلة
# اتركه فارغًا محليًا لاستخدام SQLite، أو ضع رابط Neon
DATABASE_URL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=غيّر-كلمة-المرور

# التخزين السحابي (اختياري محليًا؛ مطلوب على Render)
# S3_BUCKET=
# S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
